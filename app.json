{
  "expo": {
    "name": "Keuanganku",
    "slug": "arus-finance",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "keuanganku",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/branding/keuanganku-icon.png",
    "splash": {
      "image": "./assets/branding/keuanganku-splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#075B5E"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.arus.finance",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Keuanganku menggunakan Face ID untuk melindungi data keuanganmu."
      }
    },
    "android": {
      "package": "com.arus.finance",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/branding/keuanganku-foreground.png",
        "backgroundColor": "#075B5E"
      },
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      "expo-sqlite",
      "expo-secure-store",
      "expo-local-authentication"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1e7e4f41-b425-4f58-b039-559639af61c2"
      }
    },
    "owner": "lxthyst"
  }
}
